# Copy to .env.local. Base URL of the API server (see api/.env.example PORT).
VITE_API_URL=http://localhost:4000/api

# Yoco publishable/public key for the client-side checkout SDK (dashboard → Settings → API Keys).
# This is the PUBLIC key only — never put the secret key here.
VITE_YOCO_PUBLIC_KEY=

# Optional — Sentry DSN for frontend error tracking.
VITE_SENTRY_DSN=

# Optional — VAPID public key for browser push subscriptions (admin new-booking alerts).
VITE_VAPID_PUBLIC_KEY=
